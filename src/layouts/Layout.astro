---
interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** 記事ページのみ。JSON-LD (Article) の生成に使う */
  headline?: string;
  datePublished?: string;
  author?: string;
}

const defaultDescriptions: Record<string, string> = {
  ja: 'AIと人間の対話の記録 – ai-CABIN 1701',
  es: 'Un registro de diálogo entre IA y humanos – ai-CABIN 1701',
  en: 'A record of dialogue between AI and human – ai-CABIN 1701',
};

const {
  title = 'Cabin 1701',
  lang = 'en',
  description,
  ogImage = 'images/hero-placeholder.png',
  ogType = 'website',
  headline,
  datePublished,
  author,
} = Astro.props;
const resolvedDescription = description ?? defaultDescriptions[lang] ?? defaultDescriptions.en;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://blog.cabin1701.com');
const ogUrl = new URL(Astro.url.pathname, site).href;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage.replace(/^\//, ''), site).href;

// エンティティの背番号。site / japoneson と同じ @id を使い、
// 全サイトの記述が「同一人物・同一組織」として1つに束ねられるようにする。
const PERSON_ID = 'https://cabin1701.com/#person';
const ORG_ID = 'https://cabin1701.com/#organization';

const personNode = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Shoko Shiraishi',
  url: 'https://cabin1701.com/',
};
const orgNode = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'ai-CABIN 1701',
  url: 'https://blog.cabin1701.com/',
};

// frontmatter の author が「AI 〜」の時は、書き手がAIクルー。
// schema.org の author は人か組織しか取れないので、AI を Person として
// 名乗らせない。組織を著者にし、編集責任者として船長を editor に立て、
// 実際に書いたクルー名は creditText / keywords で残す。
const isAiCrew = typeof author === 'string' && /^AI\s/.test(author);

// 記事ページには JSON-LD (Article) を出す。
// 17年分が「同じ著者による、日付のある連続した記録」であることを機械可読にするため。
const articleJsonLd =
  ogType === 'article' && headline && datePublished
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline,
        datePublished,
        dateModified: datePublished,
        inLanguage: lang,
        description: resolvedDescription,
        image: ogImageAbs,
        mainEntityOfPage: { '@type': 'WebPage', '@id': ogUrl },
        ...(isAiCrew
          ? {
              author: orgNode,
              editor: personNode,
              creditText: author,
              keywords: [`書き手: ${author}`],
            }
          : { author: personNode }),
        publisher: orgNode,
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="idEPAPegdezVUZwVszk8ODei_eDHZnKbgAJ3lOLh6l0" />
    <title>{title}</title>

    <meta name="description" content={resolvedDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content="ai-CABIN 1701" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="canonical" href={ogUrl} />

    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alice&family=Asap:ital,wght@0,400..700;1,400..700&family=Caladea:ital,wght@0,400;0,700;1,400;1,700&family=Italianno&family=Lora:ital,wght@0,400..700;1,400..700&family=Marcellus&family=Marcellus+SC&family=Nunito:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Pathway+Gothic+One&family=Shippori+Mincho:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
